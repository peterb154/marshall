# Generated output -- charts, missions, audio, screenshots
/build/
*.miz
*.wav
*.ogg
shots/

# Generated HTML lives in build/; never commit rendered pages
/src/marshall/**/*.html

# Local environment
.env
.venv/
__pycache__/
*.pyc

# Editors / OS
.idea/
.vscode/
.DS_Store
desktop.ini

# Claude Code local settings (per-machine) and its transient temp files
.claude/settings.local.json
# Agent worktrees. Created by `isolation: "worktree"`, removed when the
# agent finishes, and never part of the repository -- a checkout of this
# repo inside itself is not a thing to commit.
.claude/worktrees/
.claude/*.tmp*

# coverage output, from tools/check.py and ad-hoc runs
.coverage
