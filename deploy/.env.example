# Copy to .env at the repo root and adjust for your machine.
# Nothing here is committed; the defaults in config.py keep everything inside
# ./build so the tools run out of the box, and you only set these to point at a
# real sim install.

# Where generated charts / missions / audio are written.
# MARSHALL_BUILD=/srv/marshall/build

# The sim's Missions folder -- a built .miz is deployed here.
# On WSL:   DCS_MISSIONS=/mnt/c/Users/YOU/Saved Games/DCS.openbeta/Missions
# On Linux: DCS_MISSIONS=/mnt/dcs/Missions
# DCS_MISSIONS=

# The sim install root -- read only by the terrain survey tool.
# DCS_INSTALL=/mnt/c/Program Files/Eagle Dynamics/DCS World OpenBeta

# The sim's Logs folder -- read by the survey reader.
# DCS_LOGS=/mnt/c/Users/YOU/Saved Games/DCS.openbeta/Logs

# Port the kneeboard chart server listens on.
# KNEEBOARD_PORT=8362
